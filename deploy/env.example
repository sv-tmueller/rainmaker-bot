# Template for /etc/rainmaker/rainmaker.env. Copy it, fill in the values, then
# `chown root:root` and `chmod 600` the copy. Never commit a filled-in copy.
#
# systemd reads this file as KEY=value lines with no shell expansion. Single
# quotes keep characters such as $ and # in a password literal.

# Supabase session-pooler DSN. Required: the wrapper refuses to run without a
# postgres:// or postgresql:// value.
DATABASE_URL='postgresql://...'

# Optional dead-man ping (healthchecks.io conventions). The wrapper calls
# <url>/start, <url> on success, and the failure unit calls <url>/fail.
# Leave empty to disable.
RAINMAKER_HEALTHCHECK_URL=

# Fine-grained GitHub token, Issues read/write on this repository only. Used by
# the failure unit to open or update the "host-run" issue. Empty means no
# GitHub alert (the failure unit logs that and exits 1).
RAINMAKER_ALERT_GH_TOKEN=

# Optional override for the wrh settlement token (see docs/operations/README.md).
# RAINYDAY_SYNOPTIC_TOKEN=

# Read by `rainmaker trade`: `off` (or unset or any unknown value) makes the
# trade step a no-op; `paper` records paper orders against the live order
# book; `live` is refused. Setting `off` is the kill switch.
RAINMAKER_TRADE_MODE=off
