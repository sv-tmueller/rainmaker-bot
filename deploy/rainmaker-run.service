[Unit]
Description=rainmaker 3h job (run, settle, prune)
After=network-online.target
Wants=network-online.target
OnFailure=rainmaker-run-failure.service

[Service]
Type=oneshot
User=rainmaker
Group=rainmaker
WorkingDirectory=/var/lib/rainmaker
StateDirectory=rainmaker
EnvironmentFile=/etc/rainmaker/rainmaker.env
# The alert token is for the failure unit only.
UnsetEnvironment=RAINMAKER_ALERT_GH_TOKEN
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/bash /opt/rainmaker/deploy/rainmaker-run.sh
# Mirrors timeout-minutes: 20 in daily-run.yml.
TimeoutStartSec=20min
# 75 is the wrapper's "another run holds the lock" skip, not a failure.
SuccessExitStatus=75

# Sandbox. The venv under /opt/rainmaker is read-only at run time; only
# /var/lib/rainmaker (StateDirectory) is writable.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0027
